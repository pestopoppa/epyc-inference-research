# G1 MI210 window watchdog (src/runtime/gpu_window_executor.py `tick`).
# Durable restore path that needs neither AutoKernel nor the session bus:
# restores at expected_end + 10 min, after AK releases its device flock, after a
# preempt, and reconciles a stale window after a reboot. Every pass writes
# /mnt/raid0/llm/tmp/gpu-window/mi210.json.executor-status.json (hub probe).
# Install (stack owner, after review):  crontab -l | cat - scripts/server/gpu_window_watchdog.cron | crontab -
* * * * * cd /mnt/raid0/llm/epyc-orchestrator && nice -n 10 python3 -m src.runtime.gpu_window_executor tick >> logs/gpu_window_watchdog.log 2>&1
@reboot sleep 90 && cd /mnt/raid0/llm/epyc-orchestrator && nice -n 10 python3 -m src.runtime.gpu_window_executor tick >> logs/gpu_window_watchdog.log 2>&1
