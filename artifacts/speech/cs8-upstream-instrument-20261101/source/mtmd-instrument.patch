+// Scratch measurement instrument only: opt-in, exclusive, length-framed trace.
+// Missing end record or an unknown status is not a completed transcript.
+struct cs8_trace {
+    FILE * f = nullptr;
+    bool enabled = false;
+    bool failed = false;
+    explicit cs8_trace(const char * mode) {
+        const char * path = std::getenv("CS8_TRANSCRIPT_PATH");
+        if (!path || !*path) return;
+        enabled = true;
+        f = std::fopen(path, "wx");
+        if (!f || std::fprintf(f, "CS8TRACE 1 %s\n", mode) < 0) failed = true;
+    }
+    void token(llama_token id, const std::string & piece) {
+        if (!enabled || failed) return;
+        if (std::fprintf(f, "T %d %zu\n", (int) id, piece.size()) < 0 ||
+            std::fwrite(piece.data(), 1, piece.size(), f) != piece.size() ||
+            std::fputc('\n', f) == EOF) failed = true;
+    }
+    bool finish(const char * status, const char * reason) {
+        if (!enabled) return true;
+        if (!failed && std::fprintf(f, "E %s %s\n", status, reason) < 0) failed = true;
+        if (!failed && std::fflush(f) != 0) failed = true;
+#if defined (__unix__) || (defined (__APPLE__) && defined (__MACH__))
+        if (!failed && fsync(fileno(f)) != 0) failed = true;
+#endif
+        return !failed;
+    }
+    ~cs8_trace() { if (f) std::fclose(f); }
+};
