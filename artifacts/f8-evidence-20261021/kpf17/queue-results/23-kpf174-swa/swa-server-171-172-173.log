            server.start()
            build_prompts()
            need_ckpt_mode()
            complete(TRUNK, 0, n_predict=0, checkpoint_at=[-1])
            c1 = complete(TRUNK + SUF[1], 1)
            assert c1["timings"]["n_fork_tokens"] == TRUNK_LEN, c1["timings"]
            assert any(c["pinned"] and c["n_tokens"] == TRUNK_LEN for c in ckpts(1))
