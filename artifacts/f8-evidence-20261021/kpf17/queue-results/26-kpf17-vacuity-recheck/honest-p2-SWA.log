        if sf["mode"] == "kv":
            assert ss[0]["prefix_hash"] != ss[1]["prefix_hash"]
    
        # an appending continuation on the same slot does not bump the epoch
        e1 = ss[1]["content_epoch"]
        complete(TRUNK + SUF[1] + c["tokens"], 1, n_predict=4)
