            t = threading.Thread(target=lambda: complete(big + SUF[0], 0, n_predict=2, checkpoint_at=js, slot_fork=False))
            t.start()
            time.sleep(delay)
            s0 = slots()[0]
            mid = s0["is_processing"] and s0.get("n_prompt_tokens", 0) < len(big)
