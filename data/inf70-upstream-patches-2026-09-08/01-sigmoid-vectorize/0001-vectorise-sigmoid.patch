+// ggml_compute_forward_silu_f32 (ops.cpp). Other type combinations keep the generic
+// per-element path.
+static void ggml_compute_forward_sigmoid_f32(const ggml_compute_params * params, ggml_tensor * dst) {
+    const ggml_tensor * src0 = dst->src[0];
+
+    GGML_ASSERT(ggml_is_contiguous_rows(src0) && ggml_is_contiguous_rows(dst) && ggml_are_same_shape(src0, dst));
