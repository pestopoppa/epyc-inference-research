    "proxies": {
      "as_of_cut": "row.recorded_at < call.started_at on 27-char normalised YYYY-MM-DDTHH:MM:SS.ffffffZ (whole seconds padded .000000); row order = raw recorded_at DESC then rowid DESC (as the SQL)",
      "call_epoch": "task_key.epoch_sha256 / measurement_epoch of the row named by call.join (store_label+rowid), i.e. the NEXT recorded attempt (time-window heuristic, no key join)",
      "invisible_answers": "same-epoch ANSWER rows before the call that are in neither the verbose 12 nor the visible Always-shown block",
      "render": "real actors.render_context({'prior_experiments': rows}, limit=12); Already-tried section = '## Already tried' to next '\\n## '",
      "run_py": "imported; real run.prior_experiments / _with_pinned_history used with ExperimentStore swapped for AsOfStore",
      "same_epoch": "row epoch == call epoch OR (row measurement_epoch not None and == call measurement_epoch); verified aliases not exported",
      "shares": "mean/median over rendered calls of per-call (group rows / rows shown); always_shown shares only over calls whose block is non-empty",
      "unexported_fields_none": [
        "falsifier",
        "result_sha256",
        "claims",
        "exact_attribution_effect_fraction",
        "target_runtime_effect_fraction"
      ]
    },
    "python": "3.13.7 (main, Mar  3 2026, 12:19:54) [GCC 15.2.0]",
    "ranking_pool": 2000,
    "recency_recall_limit": 40,
